# Example environment variables for CAS Platform
# Copy to `.env.local` for local development.
# On Vercel: set the same keys in Project → Settings → Environment Variables (Production).
# NEXT_PUBLIC_* must be set for Production builds (embedded at build time).

# --- Required (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://aimani.ai

# --- Required for BYOK key encryption ---
ENCRYPTION_SECRET=

# --- AI providers (server-side; set all you use in production) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CLAUDE_API_KEY=

# --- PayPal (credit purchases) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# sandbox | live (defaults: sandbox in dev, live in production)
PAYPAL_ENV=
# Subscription billing plans (from scripts/create-paypal-subscription-plans.mjs)
PAYPAL_SUBSCRIPTION_PRODUCT_ID=
PAYPAL_SUBSCRIPTION_PLAN_LIGHT=
PAYPAL_SUBSCRIPTION_PLAN_STANDARD=
PAYPAL_SUBSCRIPTION_PLAN_PRO=
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- Email (PayPal purchase confirmations via Resend) ---
RESEND_API_KEY=

# --- Optional ---
ARENA_FINAL_BUNDLE_SECRET=

# Not used (this app uses Supabase Auth, not NextAuth): NEXTAUTH_URL

