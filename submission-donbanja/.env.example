# ── 동반자 (care) — environment variables ──────────────────────────────────
# Copy to `.env.local` and fill in real values. Never commit real secrets.

# Anthropic Claude — powers all AI features (안부/말벗, 증상 안내, 이야기, 브레인, 뉴스 등)
ANTHROPIC_API_KEY=

# Perplexity — grounds AI answers in real, cited facts (뉴스, 증상, 지금 문 연 곳)
PERPLEXITY_API_KEY=

# data.go.kr 건강보험심사평가원 서비스 키 — 병원/약국 정보 조회 (HIRA)
KPX_SERVICE_KEY=

# Supabase — content caches (이야기/브레인 등). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
